# ---- Auth: pick ONE of the two flows -----------------------------------------
# COOKIE FLOW (recommended -- skips the Cloudflare Turnstile on the login form).
# In the browser where you are logged in, open the devtools console and run:
#     document.cookie
# Copy the whole output. Then either set it here, or keep it out of .env with:
#     npm run import-cookie -- --file cookie.txt
# The access token inside lasts 60 minutes; the bot refreshes it automatically
# from the refresh token baked into the same cookie, so you do not re-paste it
# every hour.
# WM_COOKIE=

# PASSWORD FLOW (only needed for `npm run login`). Leave unset if you use the
# cookie flow. Expect to fight Turnstile.
# WM_EMAIL=you@example.com
# WM_PASSWORD=your-password

# ---- Target -----------------------------------------------------------------
# WM_BASE_URL=https://www.wiki-masters.com

# ---- Paths (all default under ./data, which is gitignored) -------------------
# WM_STATE_PATH=./data/storage-state.json
# WM_META_PATH=./data/session-meta.json
# WM_PROFILE_DIR=./data/profile
# WM_LOCK_PATH=./data/bot.lock
# WM_LEDGER_PATH=./data/auth-ledger.json
# WM_DEBUG_DIR=./data/debug

# ---- Browser identity -------------------------------------------------------
# Leave WM_USER_AGENT unset. The bot then uses the real browser's own UA and
# records it, so the API calls send exactly the same UA as the login did. Only
# set it if you must force a specific string -- lying about the platform is
# itself a fingerprint inconsistency Cloudflare can spot.
# WM_USER_AGENT=
# 'chrome' uses real Google Chrome (better against Turnstile). Set empty to use
# Playwright's bundled Chromium instead.
# WM_BROWSER_CHANNEL=chrome
# WM_LOCALE=fr-FR
# WM_TIMEZONE=Europe/Paris
# Headed is far less detectable; in Docker it runs headed under Xvfb.
# Set true only to debug.
# WM_HEADLESS=false

# ---- Schedule ---------------------------------------------------------------
# Deliberately 61, not 60: each run lands past a rolling one-hour refill
# instead of racing it.
# WM_INTERVAL_MINUTES=61

# ---- Pack loop --------------------------------------------------------------
# WM_OPEN_DELAY_MIN_MS=5000
# WM_OPEN_DELAY_MAX_MS=10000
# The open endpoint is slow, so this is generous on purpose.
# WM_REQUEST_TIMEOUT_MS=180000
# WM_MAX_PACKS=200
# 45 min, comfortably under the 61 min period.
# WM_RUN_BUDGET_MS=2700000
# WM_MAX_CONSECUTIVE_ERRORS=4
# Bail if packs_remaining stops going down, so we never hammer the endpoint.
# WM_STALL_LIMIT=3

# ---- Cloudflare Turnstile ---------------------------------------------------
# Bounded on purpose: Turnstile can stall forever.
# WM_TURNSTILE_TIMEOUT_MS=60000

# ---- Login backoff ----------------------------------------------------------
# After a failed login, wait before trying again: 2h, 4h, 8h ... capped at 24h.
# Retrying a refused challenge every hour only burns the IP's reputation.
# WM_LOGIN_BACKOFF_BASE_MS=7200000
# WM_LOGIN_BACKOFF_MAX_MS=86400000

# ---- Supabase (auth backend) -------------------------------------------------
# Defaults are correct for wiki-masters.com. The anon key is public -- it is
# shipped to every visitor's browser -- so it lives in the code, not in secrets.
# WM_SUPABASE_URL=https://cyrxjeppjqsxxjayfrur.supabase.co
# WM_SUPABASE_ANON_KEY=
# Refresh the access token this many ms before it actually expires.
# WM_TOKEN_SKEW_MS=120000

# ---- Pre-flight --------------------------------------------------------------
# Read the account profile before opening anything. Keeps a run with no packs
# from touching the pack endpoint at all, and refuses to run against an account
# the site has flagged.
# WM_PREFLIGHT=true
# Run anyway when the account shows cheat strikes or a sanction. Think first.
# WM_ALLOW_WHEN_STRUCK=false

# ---- Optional ---------------------------------------------------------------
# Alerts on hard auth failure so the bot isn't silently dead for a week.
# Works with Discord, Slack and ntfy webhook URLs.
# WM_NOTIFY_WEBHOOK_URL=
# An authenticated GET that does NOT open a pack. If you know one, set it and
# `npm run probe` becomes a true end-to-end check.
# WM_PROBE_PATH=
# WM_LOG_LEVEL=info
